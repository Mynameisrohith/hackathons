
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the RetailSpark application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user."
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile photo.",
          "format": "uri"
        },
        "creationTime": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "displayName"
      ]
    },
    "Category": {
        "title": "Product Category",
        "type": "object",
        "description": "Represents a category for products.",
        "properties": {
          "name": { "type": "string", "description": "Name of the category." },
          "description": { "type": "string", "description": "Description of the category." },
          "imageUrl": { "type": "string", "format": "uri", "description": "URL of the category image." },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["name", "description", "imageUrl"]
    },
    "Product": {
        "title": "Product",
        "type": "object",
        "description": "Represents a product in the store.",
        "properties": {
          "name": { "type": "string" },
          "price": { "type": "number" },
          "stock": { "type": "number" },
          "description": { "type": "string" },
          "imageUrl": { "type": "string", "format": "uri" },
          "categoryId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["name", "price", "stock", "categoryId", "imageUrl", "description"]
    },
    "Sale": {
        "title": "Sale",
        "type": "object",
        "description": "Represents a sales transaction.",
        "properties": {
          "productId": { "type": "string" },
          "productName": { "type": "string" },
          "quantity": { "type": "number" },
          "totalAmount": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["productId", "productName", "quantity", "totalAmount"]
    },
    "Review": {
        "title": "Review",
        "type": "object",
        "description": "Represents a product review.",
        "properties": {
          "productId": { "type": "string" },
          "productName": { "type": "string" },
          "rating": { "type": "number" },
          "comment": { "type": "string" },
          "userId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["productId", "productName", "rating", "comment", "userId"]
    },
    "Role": {
        "title": "Role",
        "type": "object",
        "description": "Represents a user role.",
        "properties": {
            "role": { "type": "string", "enum": ["admin"] }
        },
        "required": ["role"]
    },
    "CartItem": {
      "title": "Cart Item",
      "type": "object",
      "description": "Represents an item in the user's shopping cart.",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "imageUrl": { "type": "string", "format": "uri" },
        "stock": { "type": "number" },
        "categoryId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "productName", "price", "quantity", "imageUrl", "stock", "categoryId"]
    },
    "Store": {
        "title": "Store",
        "type": "object",
        "description": "Represents a physical store location.",
        "properties": {
            "name": { "type": "string" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "address": { "type": "string" },
            "phone": { "type": "string" },
            "placeId": { "type": "string" }
        },
        "required": ["name", "latitude", "longitude", "address"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Represents a customer's placed order.",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["COD", "Card", "UPI"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Paid", "Failed"] },
        "paymentId": { "type": "string", "description": "The transaction ID from the payment gateway." },
        "orderStatus": { "type": "string", "enum": ["Pending", "Packed", "Out for Delivery", "Delivered", "Cancelled"] },
        "deliveryStatus": { "type": "string", "enum": ["Assigned", "Picked", "Out for Delivery", "Delivered"] },
        "deliveryBoyLat": { "type": "number" },
        "deliveryBoyLng": { "type": "number" },
        "estimatedArrivalMinutes": { "type": "number" },
        "cancellationReason": { "type": "string", "description": "Reason for order cancellation." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "dealerName": { "type": "string" },
        "dealerAddress": { "type": "string" },
        "dealerLat": { "type": "number" },
        "dealerLng": { "type": "number" },
        "dealerPlaceId": { "type": "string" },
        "deliveryBoyName": { "type": "string" },
        "deliveryBoyPhone": { "type": "string" },
        "feedback": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["userId", "userEmail", "items", "totalAmount", "customerName", "phone", "address", "city", "pincode", "latitude", "longitude", "paymentMethod", "paymentStatus", "orderStatus", "dealerName", "dealerAddress", "dealerLat", "dealerLng"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information. Authorization is based on path ownership.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": { "$ref": "#/backend/entities/Category" },
          "description": "Stores product categories. Publicly readable, but only manageable by administrators.",
          "params": [
            {
              "name": "categoryId",
              "description": "The unique identifier for the category."
            }
          ]
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Stores product information. Publicly readable, but only manageable by administrators.",
          "params": [
            {
              "name": "productId",
              "description": "The unique identifier for the product."
            }
          ]
        }
      },
      {
        "path": "/sales/{saleId}",
        "definition": {
          "entityName": "Sale",
          "schema": {
            "$ref": "#/backend/entities/Sale"
          },
          "description": "Stores sales transaction data. Any authenticated user can create a sale, but only admins can modify or delete transactions.",
          "params": [
            {
              "name": "saleId",
              "description": "The unique identifier for the sale transaction."
            }
          ]
        }
      },
      {
        "path": "/reviews/{reviewId}",
        "definition": {
          "entityName": "Review",
          "schema": {
            "$ref": "#/backend/entities/Review"
          },
          "description": "Stores product reviews. Publicly readable. Any authenticated user can create a review.",
          "params": [
            {
              "name": "reviewId",
              "description": "The unique identifier for the review."
            }
          ]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "AdminRole",
          "schema": {
            "$ref": "#/backend/entities/Role"
          },
          "description": "Marks a user as an administrator. Existence of the document grants admin privileges.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user who is an administrator."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/cart/{cartItemId}",
        "definition": {
          "entityName": "CartItem",
          "schema": {
            "$ref": "#/backend/entities/CartItem"
          },
          "description": "Stores items in a user's shopping cart. Only accessible by the user.",
          "params": [
            { "name": "userId", "description": "The user's ID." },
            { "name": "cartItemId", "description": "The unique ID for the cart item." }
          ]
        }
      },
      {
        "path": "/users/{userId}/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": {
            "$ref": "#/backend/entities/Order"
          },
          "description": "Stores a user's past orders. Accessible by the user who created it and by admins.",
          "params": [
            { "name": "userId", "description": "The user's ID." },
            { "name": "orderId", "description": "The unique ID for the order." }
          ]
        }
      },
      {
        "path": "/stores/{storeId}",
        "definition": {
          "entityName": "Store",
          "schema": { "$ref": "#/backend/entities/Store" },
          "description": "Stores physical store locations (dealers). Publicly readable, but only manageable by administrators.",
          "params": [
            { "name": "storeId", "description": "The unique ID for the store." }
          ]
        }
      }
    ],
    "reasoning": "The Firestore data structure supports a retail management application with products, categories, sales, and analytics. User data is isolated under `/users/{userId}`. Products, categories, and sales are in top-level collections for easy querying. A dedicated `/roles_admin/{userId}` collection manages administrator roles, enhancing security and simplifying rules by avoiding `get()` calls. The addition of user-specific `cart` and `orders` sub-collections ensures data privacy and scalability for the marketplace features. A new `stores` collection is added to manage physical store locations for proximity-based features. The `Order` entity now includes detailed information about the dispatching dealer and has been updated with `orderStatus` and other fields to support the full order lifecycle and email notifications."
  }
}
