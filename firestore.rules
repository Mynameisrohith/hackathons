
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getRoleData(uid) {
      return get(/databases/$(database)/documents/roles/$(uid)).data;
    }

    function isRole(role) {
      let userRole = getRoleData(request.auth.uid);
      return isSignedIn() && userRole != null && userRole.role == role && userRole.status == 'active';
    }

    function isAdmin() {
      return isRole('admin');
    }
    
    function isSuperAdmin() {
      return request.auth.token.email == 'drohith7080@gmail.com';
    }

    // ROLES COLLECTION RULES
    match /roles/{userId} {
      // Any signed-in user can read any role document.
      allow get: if isSignedIn();
      
      // Users can only create their own role document upon signup.
      allow create: if isOwner(userId);
      
      // Super Admin can update any document.
      // Regular Admins can only update documents for users that are NOT Super Admins.
      allow update: if isSuperAdmin() || (isAdmin() && resource.data.isSuperAdmin != true);

      // No one can delete role documents.
      allow delete: if false;
      
      // Admins and Super Admins can list all roles.
      allow list: if isAdmin() || isSuperAdmin();
    }

    // USER-SPECIFIC DATA
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isSuperAdmin();
      allow list: if isAdmin() || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(userId) || isAdmin() || isSuperAdmin();
        allow delete: if false;
      }
    }

    // COLLECTION GROUP FOR ORDERS
    match /{path=**}/orders/{orderId} {
        allow list: if isAdmin() || isSuperAdmin();
    }

    // PUBLIC/ADMIN-WRITABLE COLLECTIONS
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /stores/{storeId} {
      allow get, list: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /sales/{saleId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isSuperAdmin();
    }
  }
}
